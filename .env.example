# Copier vers .env sur le VPS. Ne jamais committer .env.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# URL publique de l'app (Caddy), sans slash final
PUBLIC_APP_URL=https://pay.example.com

# Même projet Supabase (Cloud pour l'instant). La clé "anon" / publishable
# est prévue pour le navigateur. Ne jamais mettre la service_role dans VITE_*.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Utilisées au runtime Node (SSR + script d'expiration des codes)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
