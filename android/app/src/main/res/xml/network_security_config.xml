<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Interdiction absolue du trafic HTTP en clair pour une sécurité bancaire -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

